# Environment Configuration Template
# Copy this file to .env and configure secrets accordingly

# Application General Config
ENV=development
LOG_LEVEL=INFO

# SQLite Database Settings
DATABASE_URL=sqlite:///data/career_intelligence.db

# LLM Providers Configuration (Fill in the providers you plan to use)
# LiteLLM will route based on standard environment names:
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Local LLM (e.g., Ollama running locally) - optional
OLLAMA_API_BASE=http://localhost:11434

# Security / Token configurations
SECRET_KEY=generate-a-secure-random-string-for-sessions
